# Your Seedream / ModelArk endpoint ID (e.g., ep-xxxxxx)
# Used for image generation on the "endpoint" model option (Seedream 4.5).
ENDPOINT_ID=YOUR_SEEDREAM_ENDPOINT_ID

# Comma-separated list of BytePlus API keys (no spaces required).
# These are the ARK keys used for BOTH image generation and Seedance video
# editing — the server rotates among them automatically.
BYTEPLUS_API_KEYS=key_one,key_two,key_three

# Optional: override the Seedance model used by the Video editing tab.
# Defaults to dreamina-seedance-2-5-260628 (Seedance 2.5).
# VIDEO_MODEL=dreamina-seedance-2-5-260628

# Public address of this server, needed to upload LOCAL clips in the Video editing
# tab (BytePlus downloads reference media from a URL server-side).
#
# You normally leave BOTH of these alone: on startup the server launches a
# cloudflared quick tunnel and writes PUBLIC_BASE_URL here itself, re-writing it
# whenever the ephemeral hostname rotates. Requires: brew install cloudflared
#
# RECOMMENDED for clips over ~10 MB: run your own named tunnel on a domain you
# control. Free quick tunnels are throttled to ~100-400 KB/s, which makes BytePlus
# time out fetching larger files. Set BOTH to switch modes (see README):
# TUNNEL_NAME=byteplus-studio
# TUNNEL_HOSTNAME=byteplus.yourdomain.com
#
# Set AUTO_TUNNEL=0 only if you want to manage the address entirely yourself.
# AUTO_TUNNEL=0
PUBLIC_BASE_URL=

# Optional: max size (MB) of an uploaded reference clip in the Video editing tab.
# Defaults to 200.
# VIDEO_UPLOAD_LIMIT_MB=200

# Optional: override default port 3000
# PORT=3000
