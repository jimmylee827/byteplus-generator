# Your Seedream / ModelArk endpoint ID (e.g., ep-xxxxxx)
# Used for image generation on the "endpoint" model option (Seedream 4.5).
ENDPOINT_ID=YOUR_SEEDREAM_ENDPOINT_ID

# Comma-separated list of BytePlus API keys (no spaces required).
# These are the ARK keys used for BOTH image and video generation — the server
# rotates among them automatically.
BYTEPLUS_API_KEYS=key_one,key_two,key_three

# Optional: override the Seedance model used by the Video tab.
# Defaults to dreamina-seedance-2-5-260628 (Seedance 2.5).
# VIDEO_MODEL=dreamina-seedance-2-5-260628

# --- Public address ------------------------------------------------------------
# The Video tab uploads local files (reference clips, first/last frame images) and
# BytePlus fetches them from a URL server-side, so this machine needs a public
# address. Pick ONE of the three modes below.
#
# 1. Quick tunnel (default — leave everything here alone).
#    On startup the server launches a cloudflared quick tunnel and writes the
#    hostname into PUBLIC_BASE_URL below itself, rewriting it whenever the
#    ephemeral hostname rotates. Requires: brew install cloudflared
#
# 2. Named tunnel on a domain you control — RECOMMENDED for clips over ~10 MB.
#    Free quick tunnels are throttled to ~100-400 KB/s, which makes BytePlus time
#    out fetching larger files. Set BOTH (see README). In this mode the address
#    comes from the tunnel itself and PUBLIC_BASE_URL is ignored — the server
#    clears any stale value on boot rather than advertising a dead hostname.
# TUNNEL_NAME=byteplus-studio
# TUNNEL_HOSTNAME=byteplus.yourdomain.com
#
# 3. Manage the address yourself. Only here does PUBLIC_BASE_URL do anything you
#    set by hand: the supervisor is off, and this value is used verbatim. Leave it
#    empty and uploads are disabled (pasted URLs still work).
# AUTO_TUNNEL=0
PUBLIC_BASE_URL=

# Optional: max size (MB) of any single file uploaded in the Video tab — a
# reference clip or a frame image. Defaults to 200.
# VIDEO_UPLOAD_LIMIT_MB=200

# Optional: override default port 3000
# PORT=3000
